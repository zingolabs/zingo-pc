# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/dist
/.pnp
.pnp.js
/target
/native/target

# native files
native.node

# staged nym-proxy binary (built from zingolib by scripts/stage-nym-proxy.js)
/resources/nym-proxy
/resources/nym-proxy.exe

# staged VC++ runtime (copied from the MSVC redist by scripts/stage-vcruntime.js)
/resources/vcruntime

# testing
/coverage

# production
/build

# misc
.DS_Store
*.tsbuildinfo
.env.local
.env.development.local
.env.test.local
.env.production.local

# node.js
#
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.provisionprofile

# throwaway self-signed cert for sideloading local MSIX builds (docs/windows-msix.md)
zingo-dev.pfx

# SwapKit API key (the real file, generated by scripts/generate-swapkit-secrets.js;
# src/swap/swapKitSecrets.copy.ts is the committed template)
src/swap/swapKitSecrets.ts
