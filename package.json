    "fs-extra": "^9.0.1",
    "js-base64": "^3.7.7",
    "lodash": "4.17.21",
    "minimatch": "^10.0.3",
    "node-gyp": "^11.4.2",
    "optimize-css-assets-webpack-plugin": "5",
