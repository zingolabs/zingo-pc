    "randomcolor": "^0.6.2",
    "react": "18.3.1",
    "react-accessible-accordion": "5.0.1",
    "react-chartjs-2": "4.3.1",
    "react-dom": "18.3.1",
    "react-modal": "^3.16.3",
    "react-router": "^5.3.3",
    "react-router-dom": "^5.3.3",
    "react-tabs": "6.0.2",
    "react-textarea-autosize": "^8.5.9",
