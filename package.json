{
  "name": "zingo-pc",
  "productName": "Zingo PC",
  "version": "2.0.23",
  "private": true,
  "description": "Zingo PC",
  "license": "MIT",
  "author": {
    "name": "zingolabs",
    "email": "zingo@zingolabs.com",
    "url": "https://github.com/zingolabs/zingo-pc"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-regular-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "chart.js": "3.9.1",
    "dateformat": "5.0.3",
    "electron-json-storage": "^4.6.0",
    "electron-settings": "^4.0.4",
    "fs-extra": "^9.0.1",
    "js-base64": "^3.7.7",
    "keytar": "^7.9.0",
    "minimatch": "^10.0.3",
    "qrcode.react": "^4.2.0",
    "randomcolor": "^0.6.2",
    "react": "18.3.1",
    "react-accessible-accordion": "5.0.1",
    "react-chartjs-2": "4.3.1",
    "react-dom": "18.3.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^6",
    "react-tabs": "6.0.2",
    "react-textarea-autosize": "^8.5.9",
    "typeface-roboto": "^1.1.13",
    "url-parse": "^1.5.10",
    "uuid": "^11.1.1",
    "zcashname-sdk": "^0.8.7"
  },
  "scripts": {
    "postinstall": "node set-resolutions-macos.js && (electron-builder install-app-deps || true) && patch-package",
    "release:prep": "node bin/prep-release.js",
    "lint": "cross-env NODE_ENV=production eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "prettier": "prettier './**/*.{js,jsx,ts,tsx}' -w",
    "start": "cross-env RUST_BACKTRACE=1 ELECTRON_ENABLE_LOGGING=1 NODE_OPTIONS=--trace-uncaught concurrently -k \"cross-env NODE_ENV=production BROWSER=none yarn react-start\" \"wait-on http://localhost:3000 && electronmon .\"",
    "script:build": "cross-env node scripts/build.js",
    "cargo:clean": "cd native && cargo clean && cd ..",
    "cargo:check": "cd native && cargo check && cd ..",
    "cargo:update": "cd native && cargo update && cd ..",
    "build": "yarn cargo:clean && yarn neon && cross-env node scripts/build.js",
    "build-mac-x64": "yarn cargo:clean && yarn neon-mac-x64 && cross-env node scripts/build.js",
    "build-mac-arm64": "yarn cargo:clean && yarn neon-mac-arm64 && cross-env node scripts/build.js",
    "build-win-x64": "yarn cargo:clean && yarn neon-win-x64 && cross-env node scripts/build.js",
    "build-win-arm64": "yarn cargo:clean && yarn neon-win-arm64 && cross-env node scripts/build.js",
    "test": "yarn neon && cross-env node scripts/test.js",
    "test:run": "yarn neon && cross-env CI=true node scripts/test.js --watchAll=false",
    "dist:linux": "rimraf dist && yarn build && electron-builder -l -c.extraMetadata.main=build/electron.js --publish never",
    "dist:linux-only-build": "electron-builder -l -c.extraMetadata.main=build/electron.js --publish never",
    "dist:mac-arm64": "rimraf dist && yarn build-mac-arm64 && node scripts/stage-nym-proxy.js --target aarch64-apple-darwin && electron-builder -m --arm64 -c.extraMetadata.main=build/electron.js --publish never",
    "dist:mac-mas": "rimraf dist && yarn cargo:clean && yarn neon-mac-x64 && cp src/native.node src/native-x64.node && yarn neon-mac-arm64 && lipo -create -output src/native.node src/native-x64.node src/native.node && rm src/native-x64.node && node scripts/stage-nym-proxy.js && cross-env node scripts/build.js && electron-builder --mac mas --universal -c.extraMetadata.main=build/electron.js --publish never",
    "dist:mac-x64": "rimraf dist && yarn build-mac-x64 && node scripts/stage-nym-proxy.js --target x86_64-apple-darwin && electron-builder -m --x64 -c.extraMetadata.main=build/electron.js --publish never",
    "dist:win-arm64": "rimraf dist && yarn build-win-arm64 && electron-builder -w --arm64 -c.extraMetadata.main=build/electron.js --publish never",
    "dist:win-x64": "rimraf dist && yarn build-win-x64 && electron-builder -w --x64 -c.extraMetadata.main=build/electron.js --publish never",
    "react-start": "cross-env node scripts/start.js",
    "neon": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --manifest-path native/Cargo.toml --message-format=json-render-diagnostics",
    "neon-mac-x64": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --target x86_64-apple-darwin --manifest-path native/Cargo.toml --message-format=json-render-diagnostics",
    "neon-mac-arm64": "rimraf src/native.node && LZMA_API_STATIC=1 cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --target aarch64-apple-darwin --manifest-path native/Cargo.toml --message-format=json-render-diagnostics",
    "neon-win-x64": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --target x86_64-pc-windows-msvc --manifest-path native/Cargo.toml --message-format=json-render-diagnostics",
    "neon-win-arm64": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --target aarch64-pc-windows-msvc --manifest-path native/Cargo.toml --message-format=json-render-diagnostics"
  },
  "electronmon": {
    "patterns": [
      "!native/**"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/helper-environment-visitor": "^7.24.7",
    "@babel/helper-explode-assignable-expression": "^7.18.6",
    "@babel/helper-hoist-variables": "^7.24.7",
    "@babel/helper-split-export-declaration": "^7.24.7",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@electron/notarize": "^3.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__template": "^7.4.4",
    "@types/dateformat": "5.0.3",
    "@types/electron-json-storage": "^4.5.4",
    "@types/jest": "29.5.12",
    "@types/lodash": "4.14.168",
    "@types/randomcolor": "^0.5.7",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/url-parse": "^1.4.11",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "babel-jest": "29.7.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-named-asset-import": "^0.3.8",
    "babel-preset-react-app": "^10.0.1",
    "bfj": "^7.0.2",
    "camelcase": "^6.3.0",
    "cargo-cp-artifact": "^0.1.9",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "chalk": "^4.1.2",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "dotenv": "8.2.0",
    "dotenv-expand": "5.1.0",
    "electron": "^40.0.0",
    "electron-build-env": "^0.2.0",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electronmon": "^2.0.3",
    "eslint": "8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^5.10.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^24.7.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "eslint-plugin-testing-library": "^3.9.2",
    "eslint-webpack-plugin": "^4.2.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-watch-typeahead": "0.6.1",
    "mini-css-extract-plugin": "^2.9.2",
    "neon-cli": "^0.10.1",
    "node-gyp": "^11.4.2",
    "open": "^8.4.2",
    "patch-package": "^8.0.1",
    "path-browserify": "^1.0.1",
    "postcss": "8.4.47",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^7.3.4",
    "postcss-normalize": "^10.0.1",
    "postcss-preset-env": "^9.6.0",
    "postcss-safe-parser": "^6.0.0",
    "prettier": "^3.8.3",
    "prompts": "2.4.0",
    "react-app-polyfill": "^3.0.0",
    "react-refresh": "^0.14.2",
    "resolve": "1.18.1",
    "resolve-url-loader": "^5.0.0",
    "rimraf": "^6.0.1",
    "sass-loader": "^14.2.1",
    "semver": "^7.5.2",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.12",
    "typescript": "^6.0.3",
    "wait-on": "^8.0.4",
    "webpack": "^5.99.0",
    "webpack-dev-server": "^5.2.0",
    "webpack-manifest-plugin": "^5.0.0",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "homepage": "./",
  "main": "./public/electron.js",
  "build": {
    "productName": "Zingo PC",
    "appId": "co.zingo.pc",
    "afterSign": "./afterMasSign.js",
    "afterAllArtifactBuild": "./afterSignHook.js",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "build/native.node",
      "node_modules/keytar/**/*.node"
    ],
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "category": "public.app-category.finance",
      "type": "distribution",
      "extraResources": [
        {
          "from": "resources/nym-proxy",
          "to": "nym-proxy"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./configs/entitlements.mac.inherit.plist",
      "bundleVersion": "165",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "protocols": [
        {
          "name": "Zcash",
          "schemes": [
            "zcash"
          ]
        }
      ],
      "target": [
        "dmg"
      ],
      "icon": "./resources/icon.icns"
    },
    "mas": {
      "category": "public.app-category.finance",
      "extraResources": [
        {
          "from": "resources/nym-proxy",
          "to": "nym-proxy"
        }
      ],
      "entitlements": "./configs/entitlements.mas.plist",
      "entitlementsInherit": "./configs/entitlements.mas.inherit.plist",
      "provisioningProfile": "./configs/Zingo_PC_Profile.provisionprofile",
      "bundleVersion": "165",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "protocols": [
        {
          "name": "Zcash",
          "schemes": [
            "zcash"
          ]
        }
      ],
      "icon": "./resources/icon.icns",
      "target": [
        "mas"
      ]
    },
    "win": {
      "icon": "./resources/icon.ico",
      "target": [
        "zip",
        "msi"
      ]
    },
    "deb": {
      "afterInstall": "scripts/postinstall.sh",
      "afterRemove": "scripts/postremove.sh"
    },
    "linux": {
      "category": "Development",
      "icon": "./resources/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "extraResources": [
        {
          "from": "resources/linux/co.zingo.pc.policy",
          "to": "co.zingo.pc.policy"
        },
        {
          "from": "resources/linux/zingo-pc-uri.sh",
          "to": "zingo-pc-uri.sh"
        },
        {
          "from": "resources/linux/apparmor/zingo-pc",
          "to": "apparmor-zingo-pc"
        }
      ],
      "mimeTypes": [
        "x-scheme-handler/zcash"
      ],
      "desktop": {
        "entry": {
          "Name": "Zingo PC",
          "Comment": "Shielded Lightclient for Zcash",
          "GenericName": "Wallet",
          "Type": "Application",
          "StartupNotify": true,
          "StartupWMClass": "zingopc",
          "Categories": "Utility;",
          "Keywords": "zingo;",
          "MimeType": "x-scheme-handler/zcash"
        }
      }
    }
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!dateformat[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "resetMocks": true
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  }
}
