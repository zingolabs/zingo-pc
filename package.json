  "scripts": {
    "postinstall": "node set-resolutions-macos.js && electron-builder install-app-deps",
    "lint": "cross-env NODE_ENV=production eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "start": "cross-env RUST_BACKTRACE=1 ELECTRON_ENABLE_LOGGING=1 NODE_OPTIONS=--trace-uncaught concurrently -k \"cross-env NODE_ENV=production BROWSER=none yarn react-start\" \"wait-on http://localhost:3000 && electronmon .\"",
    "script:build": "cross-env NODE_OPTIONS=--openssl-legacy-provider node scripts/build.js",
    "cargo:clean": "cd native && cargo clean && cd ..",
    "cargo:update": "cd native && cargo update && cd ..",
    "build": "yarn cargo:clean && yarn neon && cross-env NODE_OPTIONS=--openssl-legacy-provider node scripts/build.js",
    "build-mac-x64": "yarn cargo:clean && yarn neon-mac-x64 && cross-env NODE_OPTIONS=--openssl-legacy-provider node scripts/build.js",
    "build-mac-arm64": "yarn cargo:clean && yarn neon-mac-arm64 && cross-env NODE_OPTIONS=--openssl-legacy-provider node scripts/build.js",
    "build-win-x64": "yarn cargo:clean && yarn neon-win-x64 && cross-env NODE_OPTIONS=--openssl-legacy-provider node scripts/build.js",
    "build-win-arm64": "yarn cargo:clean && yarn neon-win-arm64 && cross-env NODE_OPTIONS=--openssl-legacy-provider node scripts/build.js",
    "test": "yarn neon && cross-env NODE_OPTIONS=--openssl-legacy-provider node scripts/test.js",
    "dist:linux": "rimraf dist && yarn build && electron-builder -l -c.extraMetadata.main=build/electron.js --publish never",
    "dist:linux-only-build": "electron-builder -l -c.extraMetadata.main=build/electron.js --publish never",
    "dist:mac-arm64": "rimraf dist && yarn build-mac-arm64 && electron-builder -m --arm64 -c.extraMetadata.main=build/electron.js --publish never",
    "dist:mac-x64": "rimraf dist && yarn build-mac-x64 && electron-builder -m --x64 -c.extraMetadata.main=build/electron.js --publish never",
    "dist:win-arm64": "rimraf dist && yarn build-win-arm64 && electron-builder -w --arm64 -c.extraMetadata.main=build/electron.js --publish never",
    "dist:win-x64": "rimraf dist && yarn build-win-x64 && electron-builder -w --x64 -c.extraMetadata.main=build/electron.js --publish never",
    "react-start": "cross-env NODE_OPTIONS=--openssl-legacy-provider node scripts/start.js",
    "neon": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --manifest-path native/Cargo.toml --message-format=json-render-diagnostics",
    "neon-mac-x64": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --target x86_64-apple-darwin --manifest-path native/Cargo.toml --message-format=json-render-diagnostics",
    "neon-mac-arm64": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --target aarch64-apple-darwin --manifest-path native/Cargo.toml --message-format=json-render-diagnostics",
    "neon-win-x64": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --target x86_64-pc-windows-msvc --manifest-path native/Cargo.toml --message-format=json-render-diagnostics",
    "neon-win-arm64": "rimraf src/native.node && cargo-cp-artifact -a cdylib zingolib-native src/native.node -- cargo build --release --target aarch64-pc-windows-msvc --manifest-path native/Cargo.toml --message-format=json-render-diagnostics"
  },
  "electronmon": {
    "patterns": [
      "!native/**"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/helper-environment-visitor": "^7.24.7",
    "@babel/helper-explode-assignable-expression": "^7.18.6",
    "@babel/helper-hoist-variables": "^7.24.7",
    "@babel/helper-split-export-declaration": "^7.24.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-export-namespace-from": "^7.8.3",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@electron/notarize": "^3.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "0.4.3",
    "@svgr/webpack": "5.5.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__template": "^7.4.4",
    "@types/dateformat": "5.0.3",
    "@types/deep-diff": "^1.0.2",
    "@types/jest": "29.5.12",
    "@types/lodash": "4.14.168",
    "@types/progress-stream": "^2.0.5",
    "@types/randomcolor": "^0.5.7",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/url-parse": "^1.4.11",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "babel-jest": "29.7.0",
    "babel-loader": "8.1.0",
    "babel-plugin-named-asset-import": "^0.3.8",
    "babel-preset-react-app": "^10.0.1",
    "bfj": "^7.0.2",
    "camelcase": "^6.3.0",
    "cargo-cp-artifact": "^0.1.9",
    "case-sensitive-paths-webpack-plugin": "2.3.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "4.3.0",
    "dotenv": "8.2.0",
    "dotenv-expand": "5.1.0",
    "electron": "^37.4.0",
    "electron-build-env": "^0.2.0",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electronmon": "^2.0.3",
    "eslint": "8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^5.10.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^24.7.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "eslint-plugin-testing-library": "^3.9.2",
    "eslint-webpack-plugin": "^2.6.0",
    "file-loader": "6.1.1",
    "html-webpack-plugin": "4.5.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-watch-typeahead": "0.6.1",
    "mini-css-extract-plugin": "0.11.3",
    "neon-cli": "^0.10.1",
    "pnp-webpack-plugin": "1.6.4",
    "postcss": "8.4.47",
    "postcss-flexbugs-fixes": "4.2.1",
    "postcss-loader": "4.3.0",
    "postcss-normalize": "8.0.1",
    "postcss-preset-env": "6.7.0",
    "postcss-safe-parser": "5.0.2",
    "prompts": "2.4.0",
    "react-dev-utils": "^11.0.3",
    "react-refresh": "^0.8.3",
    "resolve": "1.18.1",
    "resolve-url-loader": "^3.1.2",
    "rimraf": "^6.0.1",
    "sass-loader": "^10.2.1",
    "semver": "7.3.2",
    "style-loader": "1.3.0",
    "terser-webpack-plugin": "4.2.3",
    "ts-pnp": "1.2.0",
    "typescript": "5.1.6",
    "url-loader": "^4.1.1",
    "wait-on": "^8.0.4",
    "webpack": "4.47.0",
    "webpack-dev-server": "3.11.3",
    "webpack-manifest-plugin": "2.2.0",
    "workbox-webpack-plugin": "5.1.4"
  },
  "resolutions": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0"
  },
  "homepage": "./",
  "main": "./public/electron.js",
  "build": {
    "productName": "Zingo PC",
    "appId": "co.zingo.pc",
    "afterAllArtifactBuild": "./afterSignHook.js",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "type": "distribution",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./configs/entitlements.mac.inherit.plist",
      "target": [
        "dmg"
      ],
      "icon": "./resources/icon.icns"
    },
    "win": {
      "icon": "./resources/icon.ico",
      "target": [
        "zip",
        "msi"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "./resources/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "mimeTypes": [
        "x-scheme-handler/zcash"
      ],
      "desktop": {
        "entry": {
          "Name": "Zingo PC",
          "Comment": "Shielded Lightclient for Zcash",
          "GenericName": "Wallet",
          "Type": "Application",
          "StartupNotify": true,
          "StartupWMClass": "zingopc",
          "Categories": "Utility;",
          "Keywords": "zingo;"
        }
      }
    }
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "resetMocks": true
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  }
}
